# Copy this file to .env_test and fill in real keys.
# .env_test is gitignored. Do not commit real API keys.

# Canonical local E2E app provider config used by test/e2e_suite.py.
E2E_PROVIDER_ID=gemini
E2E_MODEL=gemini-2.5-flash
E2E_API_KEY=your_app_provider_api_key_here
# Or, for local-only reuse of an already configured Krill provider:
# E2E_API_KEY=@krill_provider:minimax

# Dedicated judge model config used by test/e2e_suite.py.
E2E_JUDGE_PROVIDER_ID=gemini
E2E_JUDGE_MODEL=gemini-2.5-flash
E2E_JUDGE_API_KEY=your_judge_provider_api_key_here
# Or, to reuse the local Codex desktop/CLI ChatGPT OAuth login:
# E2E_JUDGE_PROVIDER_ID=openai_codex_oauth
# E2E_JUDGE_MODEL=gpt-5.5
# E2E_JUDGE_API_KEY=@codex_auth

# Optional local runner settings.
# E2E_PORT=8056
# E2E_TIMEOUT_SECONDS=180
# E2E_KEEP_ARTIFACTS=0

# Backward-compatible Gemini key names still supported by older tests and as
# fallback aliases for E2E_API_KEY.
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
